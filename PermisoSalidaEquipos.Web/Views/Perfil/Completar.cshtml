@model PerfilViewModel
@{
    ViewData["Title"] = "Completar perfil";
}

<h1>Completa tu perfil</h1>
<p class="text-muted">
    Antes de poder radicar o aprobar permisos de salida de equipo necesitamos algunos datos tuyos.
    Tu usuario de dominio es <strong>@Model.NombreUsuarioDominio</strong>.
</p>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Perfil" asp-action="Completar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UsuarioId" />
            <input type="hidden" asp-for="NombreUsuarioDominio" />
            <input type="hidden" asp-for="EsDirectorTI" />

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cedula" class="form-label"></label>
                <input asp-for="Cedula" class="form-control" />
                <span asp-validation-for="Cedula" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cargo" class="form-label"></label>
                <input asp-for="Cargo" class="form-control" />
                <span asp-validation-for="Cargo" class="text-danger"></span>
            </div>

            @if (!Model.EsDirectorTI)
            {
                <div class="mb-3">
                    <label asp-for="JefeInmediatoId" class="form-label"></label>
                    <select asp-for="JefeInmediatoId" class="form-select">
                        <option value="">-- Selecciona tu jefe inmediato --</option>
                        @foreach (var jefe in Model.JefesDisponibles)
                        {
                            <option value="@jefe.Id">@jefe.NombreCompleto @(jefe.Cargo != null ? $"({jefe.Cargo})" : "")</option>
                        }
                    </select>
                    <span asp-validation-for="JefeInmediatoId" class="text-danger"></span>
                </div>
            }
            else
            {
                <p class="text-muted">Como Director de TI, tus propias solicitudes van directamente a aprobación final, sin jefe inmediato.</p>
            }

            <button type="submit" class="btn btn-primary">Guardar y continuar</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
