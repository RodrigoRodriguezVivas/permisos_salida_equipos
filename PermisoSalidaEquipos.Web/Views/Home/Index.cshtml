@{
    ViewData["Title"] = "Inicio";
    var usuario = (PermisoSalidaEquipos.Web.Models.Usuario)ViewBag.Usuario;
    var rolActual = usuario.Rol?.Nombre;
}

<h1 class="mb-3">Hola, @usuario.NombreCompleto</h1>
<p class="text-muted">Rol: <span class="badge bg-secondary">@RoleNames.NombreAmigable(rolActual)</span> @(usuario.Cargo != null ? $"· {usuario.Cargo}" : "")</p>

<div class="row g-3 mt-2">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Mis solicitudes</h5>
                <p class="card-text display-6">@ViewBag.MisSolicitudesTotal</p>
                <p class="text-muted">@ViewBag.MisSolicitudesPendientes pendiente(s) de aprobación</p>
                <a class="btn btn-primary" asp-controller="Solicitudes" asp-action="Mias">Ver mis solicitudes</a>
                <a class="btn btn-outline-secondary" asp-controller="Solicitudes" asp-action="Crear">Nueva solicitud</a>
            </div>
        </div>
    </div>

    @if (rolActual == RoleNames.JefeInmediato || rolActual == RoleNames.DirectorTI)
    {
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Aprobaciones como jefe inmediato</h5>
                    <p class="card-text display-6">@ViewBag.PendientesComoJefe</p>
                    <p class="text-muted">solicitudes esperando tu revisión</p>
                    <a class="btn btn-primary" asp-controller="Aprobaciones" asp-action="PendientesJefe">Revisar</a>
                </div>
            </div>
        </div>
    }

    @if (rolActual == RoleNames.DirectorTI)
    {
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Aprobaciones como Director de TI</h5>
                    <p class="card-text display-6">@ViewBag.PendientesComoDirector</p>
                    <p class="text-muted">solicitudes esperando aprobación final</p>
                    <a class="btn btn-primary" asp-controller="Aprobaciones" asp-action="PendientesDirector">Revisar</a>
                </div>
            </div>
        </div>
    }

    @if (rolActual == RoleNames.GuardaSeguridad || rolActual == RoleNames.DirectorTI)
    {
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Salidas por confirmar (portería)</h5>
                    <p class="card-text display-6">@ViewBag.PendientesComoGuarda</p>
                    <p class="text-muted">equipos aprobados esperando salir de la empresa</p>
                    <a class="btn btn-primary" asp-controller="Guardia" asp-action="PendientesSalida">Revisar</a>
                </div>
            </div>
        </div>
    }

    @if (rolActual == RoleNames.DirectorTI)
    {
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Administración</h5>
                    <p class="text-muted">Roles, jefes inmediatos y reportes de todas las solicitudes.</p>
                    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Usuarios">Usuarios y roles</a>
                    <a class="btn btn-outline-secondary" asp-controller="Reportes" asp-action="Index">Reportes</a>
                </div>
            </div>
        </div>
    }
</div>
