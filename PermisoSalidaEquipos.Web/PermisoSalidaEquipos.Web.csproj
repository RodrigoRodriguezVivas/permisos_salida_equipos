<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>permiso-salida-equipos-aligraf</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Autenticación integrada de Windows (SSO) contra Active Directory vía IIS. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.10" />

    <!-- Consulta a Active Directory (LDAP) para autocompletar nombre, correo y cargo. -->
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.1" />

    <!-- Acceso a SQL Server (producción) y SQLite (sitio de demostración pública). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Envío de correo (notificaciones del flujo de aprobación). -->
    <PackageReference Include="MailKit" Version="4.8.0" />

    <!-- Exportar el historial de solicitudes a Excel. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

</Project>
